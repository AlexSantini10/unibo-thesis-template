{
  "latex-workshop.latex.rootFile.useSubFile": false,
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.search.rootFiles.include": [
    "main.tex"
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-shell-escape",
        "-file-line-error",
        "-halt-on-error",
        "-interaction=nonstopmode",
        "-synctex=1",
        "%DOC%"
      ]
    },
    {
      "name": "cleanup-successful-build",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$base = [System.IO.Path]::Combine('%DIR%', '%DOCFILE%'); $extensions = @('.acn','.acr','.alg','.aux','.bbl','.bcf','.blg','.dvi','.fdb_latexmk','.fls','.glg','.glo','.gls','.idx','.ilg','.ind','.ist','.lof','.lot','.nav','.out','.run.xml','.snm','.synctex.gz','.toc','.vrb','.xdv'); foreach ($extension in $extensions) { $file = \"$base$extension\"; if (Test-Path -LiteralPath $file) { Remove-Item -LiteralPath $file -Force } }"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk",
      "tools": [
        "latexmk",
        "cleanup-successful-build"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.view.pdf.viewer": "tab"
}
